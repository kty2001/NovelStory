      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "몰락한 잿빛 왕가의 막내 공주. 왕의 서거 뒤 "
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "d-kael",
                  "label": "카엘"
                }
              },
              {
                "type": "text",
                "text": "의 도움으로 "
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "d-castle",
                  "label": "잿빛 성"
                }
              },
              {
                "type": "text",
                "text": "을 빠져나온다."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "왕가의 피에 잠든 "
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "d-flame",
                  "label": "재의 불꽃"
                }
              },
              {
                "type": "text",
                "text": "을 이어받았지만 아직 깨어나지 않았다."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-09-26T00:00:00.000Z",
      "color": "brand-pink"
    },
